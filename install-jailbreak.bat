@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title Trình cài đặt Jailbreak cho OpenCode

set "GLOBAL_DIR=%USERPROFILE%\.config\opencode"
set "GLOBAL_FILE=%GLOBAL_DIR%\AGENTS.md"
set "PROJECT_DIR=%CD%"
set "PROJECT_FILE=%PROJECT_DIR%\AGENTS.md"
set "CATALOG=%TEMP%\ocjb_catalog.txt"
set "BKLIST=%TEMP%\ocjb_backups.txt"
set "WORK=%TEMP%\ocjb_work"
if not exist "%WORK%" mkdir "%WORK%" >nul 2>&1

call :load_catalog

set "TOTAL=0"
for /f "usebackq delims=" %%L in ("%CATALOG%") do set /a TOTAL+=1
set "VENDORS=0"
set "LASTV="
for /f "usebackq tokens=1,2,3,4 delims=|" %%A in ("%CATALOG%") do (
    if not "%%B"=="!LASTV!" (
        set /a VENDORS+=1
        set "LASTV=%%B"
    )
)

if /i "%~1"=="/selftest" goto :cli_selftest
if /i "%~1"=="/list" goto :cli_list
if /i "%~1"=="/install" goto :cli_install

:main
cls
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   OPENCODE  ·  TRÌNH CÀI ĐẶT JAILBREAK                     │
echo   ├────────────────────────────────────────────────────────────┤
echo   │   TỔNG PROMPT : !TOTAL!          NHÓM VENDOR : !VENDORS!               │
echo   ├────────────────────────────────────────────────────────────┤
echo   │  STT   VENDOR                 MODEL                        │
echo   ├────────────────────────────────────────────────────────────┤
set /a K=0
for /f "usebackq tokens=1,2,3,4 delims=|" %%A in ("%CATALOG%") do (
    set /a K+=1
    if !K! leq 10 echo   │   %%A    %%B                 %%C
)
echo   ├────────────────────────────────────────────────────────────┤
echo   │   [1] Cài đặt     [2] Model       [3] Xem trước            │
echo   │   [4] Sao lưu     [5] Gỡ cài đặt  [0] Thoát                │
echo   ├────────────────────────────────────────────────────────────┤
echo   │   Prompt đã nhúng sẵn trong file .bat này                  │
echo   └────────────────────────────────────────────────────────────┘
echo.
echo      Global  : %GLOBAL_FILE%
echo      Project : %PROJECT_FILE%
echo.
set "CH="
set /p "CH=   ▸ Chọn [0-5]: "
if not defined CH goto :end
if "!CH!"=="1" goto :pick_install
if "!CH!"=="2" goto :show_models
if "!CH!"=="3" goto :pick_preview
if "!CH!"=="4" goto :restore
if "!CH!"=="5" goto :uninstall
if "!CH!"=="0" goto :end
goto :main

:load_catalog
del "%CATALOG%" 2>nul
set "IN=0"
for /f "usebackq delims=" %%L in ("%~f0") do (
    if "!IN!"=="0" (
        if "%%L"=="###CATALOG###" set "IN=1"
    ) else (
        if "%%L"=="###ENDCAT###" goto :cat_done
        >>"%CATALOG%" echo(%%L
    )
)
:cat_done
exit /b 0

:show_catalog
cls
set /a N=0
set /a PAGE=1
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   DANH SÁCH JAILBREAK   ·   trang !PAGE!                        │
echo   ├────────────────────────────────────────────────────────────┤
echo   │  STT   VENDOR                 MODEL                        │
echo   ├────────────────────────────────────────────────────────────┤
for /f "usebackq tokens=1,2,3,4 delims=|" %%A in ("%CATALOG%") do (
    echo   │   %%A    %%B                 %%C
    set /a N+=1
    set /a M=!N! %% 24
    if !M!==0 (
        echo   ├────────────────────────────────────────────────────────────┤
        echo   │   --- hết trang !PAGE! --- nhấn phím để tiếp ---
        pause >nul
        set /a PAGE+=1
        cls
        echo.
        echo   ┌────────────────────────────────────────────────────────────┐
        echo   │   DANH SÁCH JAILBREAK   ·   trang !PAGE!                        │
        echo   ├────────────────────────────────────────────────────────────┤
        echo   │  STT   VENDOR                 MODEL                        │
        echo   ├────────────────────────────────────────────────────────────┤
    )
)
echo   └────────────────────────────────────────────────────────────┘
echo.
echo   Tổng: !TOTAL! prompt.   Nhóm vendor: !VENDORS!
exit /b 0

:resolve_pick
set "SEL_IDX="
set "SEL_LABEL="
set "SEL_EXT="
set "Q=%~1"
if "!Q!"=="" exit /b 0
echo(!Q!|findstr /r "^[0-9][0-9]*$" >nul || exit /b 0
if "!Q:~1!"=="" set "Q=0!Q!"
for /f "usebackq tokens=1,2,3,4 delims=|" %%A in ("%CATALOG%") do (
    if "%%A"=="!Q!" (
        set "SEL_IDX=%%A"
        set "SEL_LABEL=%%B / %%C"
        set "SEL_EXT=%%D"
    )
)
exit /b 0

:pick_install
set "PAGE=1"
call :show_catalog
echo.
set "PICK="
set /p "PICK=   ▸ Nhập số thứ tự (0 = quay lại): "
if not defined PICK goto :main
if "!PICK!"=="0" goto :main
call :resolve_pick "!PICK!"
if not defined SEL_IDX goto :pick_bad

:install_menu
cls
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   ĐÃ CHỌN                                                  │
echo   ├────────────────────────────────────────────────────────────┤
echo   │   Mã    : !SEL_IDX!
echo   │   Prompt: !SEL_LABEL!
echo   ├────────────────────────────────────────────────────────────┤
echo   │   [1]  Cài GLOBAL                                          │
echo   │   [2]  Cài PROJECT                                         │
echo   │   [3]  Cài cả hai                                          │
echo   │   [4]  Xem trước nội dung                                  │
echo   │   [5]  Cài vào đường dẫn tùy chọn                          │
echo   │   [0]  Quay lại                                            │
echo   └────────────────────────────────────────────────────────────┘
echo.
echo      Global  : %GLOBAL_FILE%
echo      Project : %PROJECT_FILE%
echo.
set "A="
set /p "A=   ▸ Chọn [0-5]: "
if not defined A goto :main
if "!A!"=="1" ( call :install_to "%GLOBAL_FILE%" & goto :after_install )
if "!A!"=="2" ( call :install_to "%PROJECT_FILE%" & goto :after_install )
if "!A!"=="3" ( call :install_to "%GLOBAL_FILE%" & call :install_to "%PROJECT_FILE%" & goto :after_install )
if "!A!"=="4" goto :preview_selected
if "!A!"=="5" (
    set "CP="
    set /p "CP=   ▸ Nhập đường dẫn file đích: "
    if defined CP ( call :install_to "!CP!" & goto :after_install )
    goto :install_menu
)
if "!A!"=="0" goto :pick_install
goto :install_menu

:preview_selected
call :extract "!SEL_IDX!" "%WORK%\preview"
if errorlevel 1 (
    echo   Lỗi: không giải mã được nội dung.
    pause
    goto :install_menu
)
cls
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   XEM TRƯỚC   ·   !SEL_LABEL!
echo   └────────────────────────────────────────────────────────────┘
echo.
more "%WORK%\preview"
echo.
echo   ────────────────────────────────────────────────────────────
pause
goto :install_menu

:pick_bad
echo.
echo   Số thứ tự không hợp lệ.
pause >nul
goto :pick_install

:after_install
echo.
echo   Mở phiên mới trong OpenCode để nạp AGENTS.md.
pause
goto :main

:install_to
set "SRC=%WORK%\payload"
call :extract "!SEL_IDX!" "!SRC!"
if errorlevel 1 (
    echo   Lỗi: không giải mã được prompt.
    exit /b 1
)
call :do_install "!SRC!" "%~1"
exit /b 0

:do_install
set "SRC=%~1"
set "DEST=%~2"
set "DDIR=%~dp2"
set "LAST_BACKUP=không có"
if not exist "!DDIR!" mkdir "!DDIR!" >nul 2>&1
if exist "!DEST!" (
    if not defined NOCONFIRM (
        echo.
        echo   ┌────────────────────────────────────────────────────────────┐
        echo   │   CẢNH BÁO: file đích đã tồn tại, sẽ bị ghi đè             │
        echo   └────────────────────────────────────────────────────────────┘
        echo      !DEST!
        echo      Một bản sao lưu sẽ được tạo trước.
        set "OK="
        set /p "OK=   ▸ Tiếp tục? [Y/N]: "
        if /i not "!OK!"=="Y" exit /b 1
    )
    call :backup "!DEST!"
)
copy /y "!SRC!" "!DEST!" >nul
if errorlevel 1 (
    echo   LỖI: không thể ghi !DEST!
    exit /b 1
)
for %%S in ("!DEST!") do set "SZ=%%~zS"
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   KẾT QUẢ CÀI ĐẶT                                          │
echo   └────────────────────────────────────────────────────────────┘
echo      Đích       : !DEST!
echo      Kích thước : !SZ! bytes
echo      Sao lưu    : !LAST_BACKUP!
exit /b 0

:backup
set "TS="
for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command "Get-Date -Format yyyyMMdd-HHmmss"`) do set "TS=%%T"
if not defined TS set "TS=%RANDOM%"
set "BK=%~1.bak.!TS!"
copy /y "%~1" "!BK!" >nul
set "LAST_BACKUP=!BK!"
exit /b 0

:show_models
cls
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   CÁC MODEL ĐƯỢC HỖ TRỢ                                    │
echo   │   !VENDORS! nhóm vendor   ·   !TOTAL! prompt                           │
echo   └────────────────────────────────────────────────────────────┘
set "LASTV="
for /f "usebackq tokens=1,2,3,4 delims=|" %%A in ("%CATALOG%") do (
    if not "%%B"=="!LASTV!" (
        echo.
        echo   ── %%B ──────────────────────────────────────────────
        set "LASTV=%%B"
    )
    echo        ▸ %%A   %%C
)
echo.
echo   ────────────────────────────────────────────────────────────
pause
goto :main

:pick_preview
set "PAGE=1"
call :show_catalog
echo.
set "PICK="
set /p "PICK=   ▸ Nhập số thứ tự để xem (0 = quay lại): "
if not defined PICK goto :main
if "!PICK!"=="0" goto :main
call :resolve_pick "!PICK!"
if not defined SEL_IDX goto :pick_bad
call :extract "!SEL_IDX!" "%WORK%\preview"
if errorlevel 1 (
    echo   Lỗi: không giải mã được nội dung.
    pause
    goto :pick_preview
)
cls
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   XEM TRƯỚC   ·   !SEL_LABEL!
echo   └────────────────────────────────────────────────────────────┘
echo.
more "%WORK%\preview"
echo.
echo   ────────────────────────────────────────────────────────────
pause
goto :pick_preview

:restore
cls
del "%BKLIST%" 2>nul
set "RIDX=0"
if exist "%GLOBAL_FILE%.bak.*" for /f "usebackq delims=" %%F in (`dir /b /a-d /on "%GLOBAL_FILE%.bak.*" 2^>nul`) do call :add_bk "%GLOBAL_DIR%\%%F"
if exist "%PROJECT_FILE%.bak.*" for /f "usebackq delims=" %%F in (`dir /b /a-d /on "%PROJECT_FILE%.bak.*" 2^>nul`) do call :add_bk "%PROJECT_DIR%\%%F"
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   SAO LƯU  /  KHÔI PHỤC                                    │
echo   └────────────────────────────────────────────────────────────┘
if not exist "%BKLIST%" (
    echo      Chưa có bản sao lưu nào.
    pause
    goto :main
)
echo      STT   ĐÍCH
for /f "usebackq tokens=1,2,3 delims=|" %%A in ("%BKLIST%") do echo      %%A    %%C
echo   ────────────────────────────────────────────────────────────
echo      Gõ số thứ tự để chọn bản sao lưu của file tương ứng.
echo.
set "PICK="
set /p "PICK=   ▸ Chọn số để khôi phục (0 = quay lại): "
if not defined PICK goto :main
if "!PICK!"=="0" goto :main
set "RBK="
set "RDEST="
set "RQ=%PICK%"
echo(!RQ!|findstr /r "^[0-9][0-9]*$" >nul || goto :restore
if "!RQ:~1!"=="" set "RQ=0!RQ!"
for /f "usebackq tokens=1,2,3 delims=|" %%A in ("%BKLIST%") do (
    if "%%A"=="!RQ!" (
        set "RBK=%%B"
        set "RDEST=%%C"
    )
)
if not defined RBK goto :restore
echo.
echo   Khôi phục : !RBK!
echo   Thành     : !RDEST!
set "OK="
set /p "OK=   ▸ Xác nhận? [Y/N]: "
if /i not "!OK!"=="Y" goto :main
copy /y "!RBK!" "!RDEST!" >nul
echo   [OK] Đã khôi phục.
pause
goto :main

:add_bk
set /a RIDX+=1
set "P2=!RIDX!"
if !RIDX! lss 10 set "P2=0!RIDX!"
set "BD=%~dp1"
>>"%BKLIST%" echo !P2!^|%~1^|!BD!AGENTS.md
exit /b 0

:uninstall
cls
echo.
echo   ┌────────────────────────────────────────────────────────────┐
echo   │   GỠ CÀI ĐẶT                                               │
echo   └────────────────────────────────────────────────────────────┘
if exist "%GLOBAL_FILE%" echo      [1]  Xóa GLOBAL  : %GLOBAL_FILE%
if exist "%PROJECT_FILE%" echo      [2]  Xóa PROJECT : %PROJECT_FILE%
echo      [0]  Quay lại
echo.
set "U="
set /p "U=   ▸ Chọn [0-2]: "
if not defined U goto :main
if "!U!"=="0" goto :main
if "!U!"=="1" call :remove_file "%GLOBAL_FILE%"
if "!U!"=="2" call :remove_file "%PROJECT_FILE%"
goto :uninstall

:remove_file
if not exist "%~1" exit /b 0
call :backup "%~1"
del /q "%~1"
echo   [OK] Đã xóa: %~1
echo        Sao lưu: !LAST_BACKUP!
pause
exit /b 0

:extract
set "FIND=###BEGIN %~1###"
set "STOP=###END %~1###"
set "B64=%WORK%\b64.txt"
set "OUT=%~2"
del "%B64%" 2>nul
if exist "!OUT!" del /q "!OUT!" >nul 2>&1
set "IN=0"
for /f "usebackq delims=" %%L in ("%~f0") do (
    if "!IN!"=="0" (
        if "%%L"=="!FIND!" set "IN=1"
    ) else (
        if "%%L"=="!STOP!" goto :extract_ok
        >>"%B64%" echo(%%L
    )
)
exit /b 1
:extract_ok
set "OCJB_B64=%B64%"
set "OCJB_OUT=%OUT%"
certutil -f -decode "%B64%" "%OUT%" >nul 2>&1
if not exist "%OUT%" powershell -NoProfile -Command "[IO.File]::WriteAllBytes($env:OCJB_OUT,[Convert]::FromBase64String((Get-Content -Raw -LiteralPath $env:OCJB_B64)))" >nul 2>&1
if not exist "%OUT%" exit /b 1
exit /b 0

:cli_selftest
echo SELFTEST_OK prompts=!TOTAL! vendors=!VENDORS!
exit /b 0

:cli_list
for /f "usebackq tokens=1,2,3,4 delims=|" %%A in ("%CATALOG%") do echo [%%A] %%B / %%C
exit /b 0

:cli_install
set "NOCONFIRM=1"
call :resolve_pick "%~2"
if not defined SEL_IDX goto :cli_bad
set "T=%~3"
if /i "!T!"=="global" goto :cli_do_global
if /i "!T!"=="project" goto :cli_do_project
if /i "!T!"=="both" goto :cli_do_both
if "!T!"=="" goto :cli_bad
call :install_to "!T!"
exit /b !ERRORLEVEL!
:cli_do_global
call :install_to "%GLOBAL_FILE%"
exit /b !ERRORLEVEL!
:cli_do_project
call :install_to "%PROJECT_FILE%"
exit /b !ERRORLEVEL!
:cli_do_both
call :install_to "%GLOBAL_FILE%"
call :install_to "%PROJECT_FILE%"
exit /b 0
:cli_bad
echo [LỖI] tham số không hợp lệ: %*
exit /b 2

:end
echo.
echo   Tạm biệt.
ping -n 2 127.0.0.1 >nul 2>&1
endlocal
exit /b 0
